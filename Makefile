# serialize.nut: the Squirrel port of serialize (DESIGN.md is the page every
# card copies; STANDARD.md, vendored verbatim, is the wire's authority).
#
#   make dist-squirrel   fetch and build the pinned interpreter (DESIGN.md (c))
#   make test            run every test/*/*_test.nut
#   make test T=<name>   run the files of test/<name>/ only (one directory per card)
#
# A later card adds its own targets in its own make/<card>.mk; this file never
# needs editing for that (the -include at the end).

.DEFAULT_GOAL := test
SHELL := /bin/bash

# THE PINNED INTERPRETER (DESIGN.md (c); schema docs/PORT-SQUIRREL.md, THE
# PINNED INTERPRETER). Squirrel 3.2 from the upstream tag, checked against one
# sha256, built as sq64 with SQUSEDOUBLE. Both switches are load-bearing: sq64
# makes SQInteger 64 bits (_intsize_ 8), and without -DSQUSEDOUBLE SQFloat is
# 32 bits (_floatsize_ 4), which no float64 survives. dist/ is gitignored.
SQUIRREL_VERSION := 3.2
SQUIRREL_URL     := https://github.com/albertodemichelis/squirrel/archive/refs/tags/v$(SQUIRREL_VERSION).tar.gz
SQUIRREL_SHA256  := 02805414cfadd5bbb921891d3599b83375a40650abd6404a8ab407dc5e86a996
SQUIRREL_DIR     := dist/squirrel-$(SQUIRREL_VERSION)
SQ ?= $(CURDIR)/$(SQUIRREL_DIR)/bin/sq
export SQ

.PHONY: dist-squirrel
dist-squirrel:
	@mkdir -p dist
	@if [ ! -f dist/squirrel-$(SQUIRREL_VERSION).tar.gz ]; then \
		curl -fsSL -o dist/squirrel-$(SQUIRREL_VERSION).tar.gz.part $(SQUIRREL_URL) && \
		mv dist/squirrel-$(SQUIRREL_VERSION).tar.gz.part dist/squirrel-$(SQUIRREL_VERSION).tar.gz; fi
	@got=$$(sha256sum dist/squirrel-$(SQUIRREL_VERSION).tar.gz | cut -d' ' -f1); \
	if [ "$$got" != "$(SQUIRREL_SHA256)" ]; then \
		echo "dist-squirrel REFUSES: dist/squirrel-$(SQUIRREL_VERSION).tar.gz has sha256 $$got, the pin is $(SQUIRREL_SHA256)"; \
		echo "  delete the file and run make dist-squirrel again; a different tarball is never built"; \
		exit 1; fi
	@if [ ! -x $(SQUIRREL_DIR)/bin/sq ]; then \
		rm -rf $(SQUIRREL_DIR) && tar -xzf dist/squirrel-$(SQUIRREL_VERSION).tar.gz -C dist && \
		{ $(MAKE) -C $(SQUIRREL_DIR) sq64 DEFS=-DSQUSEDOUBLE > dist/squirrel-build.log 2>&1 || { cat dist/squirrel-build.log; exit 1; }; }; fi
	@echo "squirrel $(SQUIRREL_VERSION) $(SQUIRREL_URL)"
	@echo "sha256 $(SQUIRREL_SHA256)"
	@echo "sq $(SQ)"

# THE TOOLCHAIN GATE: refuses by name when the pin does not resolve, never a skip.
.PHONY: toolchain-squirrel
toolchain-squirrel:
	@if [ ! -x "$(SQ)" ]; then \
		echo "toolchain-squirrel REFUSES: the pinned interpreter SQ=$(SQ) does not resolve; run make dist-squirrel"; \
		exit 1; fi

# THE RUNNER (DESIGN.md (i)). A test file declares root functions named
# Test<Name>; a test passes by returning and fails by throwing. Each named test
# runs in its own sq process, from the scratch directory build/test/<dir>/
# (gitignored), through the driver below:
#
#   sq build/sqtest.nut <repo root> <test file> <Test name>
#
# The driver prints the sentinel line only after the test returns. sq exits 0
# on an uncaught throw (measured on the pin: the error and the call stack go
# to stderr), so a run passes only when sq exits 0 AND writes nothing to
# stderr AND printed the sentinel; anything else is --- FAIL. A missing or
# empty test/<name>/ fails by name, never a skip.
define SQTEST_DRIVER
// generated by the Makefile (THE RUNNER, DESIGN.md (i)); never edit
local root = vargv[0];
local path = vargv[1];
local name = vargv[2];
::SERIALIZE_ROOT <- root;
dofile(path, true);
if (!(name in ::getroottable())) throw "runner: " + path + " declares no " + name;
::getroottable()[name]();
print("sqtest-sentinel-pass " + name + "\n");
endef
export SQTEST_DRIVER

T ?=
TEST_FILES = $(if $(T),$(sort $(wildcard test/$(T)/*_test.nut)),$(sort $(wildcard test/*/*_test.nut)))

.PHONY: test
test: toolchain-squirrel
	@mkdir -p build
	@printf '%s\n' "$$SQTEST_DRIVER" > build/sqtest.nut
	@if [ -n "$(T)" ] && [ ! -d "test/$(T)" ]; then echo "FAIL test/$(T)/: no such test directory"; exit 1; fi
	@if [ -z "$(strip $(TEST_FILES))" ]; then echo "FAIL $(if $(T),test/$(T)/,test/*/): no *_test.nut files"; exit 1; fi
	@root=$(CURDIR); fails=0; count=0; \
	for f in $(TEST_FILES); do \
		names=$$(grep -oE '^function (Test[A-Za-z0-9_]+)' "$$f" | sed 's/^function //'); \
		if [ -z "$$names" ]; then echo "FAIL $$f: declares no Test<Name> function"; fails=$$((fails+1)); continue; fi; \
		dir=$$(basename $$(dirname "$$f")); \
		for n in $$names; do \
			count=$$((count+1)); echo "RUN $$n"; \
			work=build/test/$$dir/$$n; rm -rf "$$work"; mkdir -p "$$work"; \
			( cd "$$work" && "$(SQ)" "$$root/build/sqtest.nut" "$$root" "$$root/$$f" "$$n" > out.txt 2> err.txt ); code=$$?; \
			cat "$$work/out.txt" | grep -v '^sqtest-sentinel-pass ' || true; \
			if [ $$code -eq 0 ] && [ ! -s "$$work/err.txt" ] && grep -qx "sqtest-sentinel-pass $$n" "$$work/out.txt"; then \
				echo "--- PASS $$n"; \
			else \
				cat "$$work/err.txt"; echo "--- FAIL $$n ($$f: exit $$code)"; fails=$$((fails+1)); fi; \
		done; \
	done; \
	if [ $$fails -ne 0 ]; then echo "FAIL $$fails of $$count"; exit 1; fi; \
	echo "ok $$count tests"

.PHONY: clean
clean:
	rm -rf build

# each later card's own targets (DESIGN.md (h)): one file per card, never this one
-include make/*.mk
